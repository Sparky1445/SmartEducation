# Copy to .env (same folder as manage.py). Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database: sqlite (default) or postgres ---
DB_ENGINE=sqlite
# DB_NAME=smart_education
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- AI engine: MOCK | GITHUB_MODELS | AZURE (same keys as PackPilot) ---
LLM_PROVIDER=MOCK

# LLM_PROVIDER=GITHUB_MODELS
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# LLM_PROVIDER=AZURE
AZURE_INFERENCE_ENDPOINT=
AZURE_INFERENCE_KEY=
AZURE_MODEL=gpt-4o-mini
# AZURE_API_VERSION=2024-10-21

# --- Related videos and websites under answers (both optional) ---
# YouTube Data API v3 key (Google Cloud console, free daily quota)
YOUTUBE_API_KEY=
# Brave Search API key (web + video results, $5 free credit a month)
BRAVE_API_KEY=
